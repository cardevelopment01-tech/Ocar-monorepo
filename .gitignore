node_modules/
.superpowers/
.next/
dist/
.turbo/
coverage/
*.log
.DS_Store
Thumbs.db
.env
.env.local
!.env.example

# Firebase service-account keys (secret credentials, never commit)
*firebase-adminsdk*.json
*-adminsdk-*.json
*.tsbuildinfo

# Stray temp auth files (Windows path mangling artifacts)
C*_auth.json
*_auth.json

# Claude Code internal files
.claude/

# Graphify generated output
graphify-out/

# Local tool caches (RTK token-tracking state, agent tooling scratch)
.tokensave/
.agents/
.superpowers/
.impeccable/

# Git worktrees for isolated feature work
.worktrees/

# Load-test signed JWTs (staging-only, but still live credentials)
load-tests/k6/tokens.json

# Terraform local state, plugin cache, and plan files -- state can contain
# secrets, plan files are throwaway. .terraform.lock.hcl IS committed
# (that's the provider version lock, meant to be version-controlled).
infra/terraform/**/.terraform/
infra/terraform/.terraform-prd/
infra/terraform/.terraform-stg/
infra/terraform/.terraform-proddestroy/
infra/terraform/observability/.terraform-obs/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/*tfplan
infra/terraform/*-api-env.txt
# decrypted API settings pulled by `pnpm env:pull` -- secrets, never commit
.api-env.*
infra/terraform/**/*.tfvars

# Local scratch that must never be committed (load-test JWTs, env backups, debug builds)
load-tests/tokens.json
*.env.local.bak
.env*.bak
*.apk

# Python bytecode (CI helper scripts)
__pycache__/
*.pyc
