// infra/alloy/config.alloy
//
// Discovers all containers on this host, tails their combined stdout/stderr
// log stream, and attaches exactly four labels (container, service, env,
// host) to keep Loki's index small —
// see docs/superpowers/specs/2026-08-08-observability-stack-design.md
// MUST-DO #2. Everything else (requestId, userId, rideId, etc.) stays in
// the JSON log body untouched — Loki can still full-text/JSON-filter on it,
// it just isn't part of the indexed label set.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    target_label = "service"
    replacement   = "ocar"
  }

  rule {
    target_label = "env"
    replacement   = sys.env("ALLOY_ENV")
  }

  rule {
    target_label = "host"
    replacement   = sys.env("ALLOY_HOSTNAME")
  }

  // Which blue/green color this instance belongs to -- lets dashboards split
  // by color during a deploy (matches the EC2 Color tag in asg.tf).
  rule {
    target_label = "color"
    replacement   = sys.env("ALLOY_COLOR")
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  forward_to    = [loki.write.grafana_cloud.receiver]
  relabel_rules = discovery.relabel.containers.rules
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// --- Metrics pipeline ---------------------------------------------------
// Scrapes the API's /metrics endpoint and node_exporter, ships both to
// Grafana Cloud Prometheus (remote_write).

// host label matches what the logs pipeline already tags each line with --
// without it, every instance's series arrive under the same identity and
// can't be told apart in a query or dashboard (see docs/superpowers/specs/
// 2026-08-08-observability-stack-design.md). color likewise matches the logs
// pipeline's color label -- lets dashboards split metrics by blue/green.
prometheus.scrape "api" {
  targets       = [{"__address__" = "api:4000", "host" = sys.env("ALLOY_HOSTNAME"), "color" = sys.env("ALLOY_COLOR")}]
  metrics_path  = "/metrics"
  forward_to    = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "node" {
  targets    = [{"__address__" = "node_exporter:9100", "host" = sys.env("ALLOY_HOSTNAME"), "color" = sys.env("ALLOY_COLOR")}]
  forward_to = [prometheus.relabel.node.receiver]
}

// node_exporter ships ~500-700 series per host unfiltered (Grafana Labs'
// own sizing guide) -- this tipped the tenant's 15k active-series cap
// during 2026-08-30's blue/green rollout (repeated instance churn each
// left its full series set "active" in Mimir until it aged out). Keep-list
// chosen for real incident/audit value, not just what ocar-overview.json
// currently queries (cpu/memory/filesystem) -- swap, inodes, disk I/O, and
// network errors/drops are exactly the signals a postmortem reaches for
// that a narrower "only what's dashboarded" list would have missed.
// device-exclude on the exporter itself (docker-compose.prod.yml) already
// keeps node_network_* bounded to real interfaces -- this keep-list is the
// second layer, same two-layer approach as prometheus.relabel "cadvisor"
// below.
prometheus.relabel "node" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // Flat enumeration, not clever suffix-combining -- node_filesystem_files/
  // _files_free/_readonly have no _bytes suffix (unlike _size/_avail), and
  // getting that wrong silently drops the metric instead of erroring.
  rule {
    source_labels = ["__name__"]
    regex = "node_(cpu_seconds_total|load1|load5|load15|memory_MemTotal_bytes|memory_MemAvailable_bytes|memory_SwapTotal_bytes|memory_SwapFree_bytes|memory_Dirty_bytes|memory_Writeback_bytes|filesystem_size_bytes|filesystem_avail_bytes|filesystem_files|filesystem_files_free|filesystem_readonly|disk_io_time_seconds_total|disk_read_bytes_total|disk_written_bytes_total|network_receive_bytes_total|network_transmit_bytes_total|network_receive_errs_total|network_transmit_errs_total|network_receive_drop_total|network_transmit_drop_total|filefd_allocated|filefd_maximum|boot_time_seconds)"
    action = "keep"
  }
}

// Every instance's exporter reports the same pg_stat_statements/pg_stat_database
// numbers (they all connect to the same shared Neon DB) -- harmless
// duplication, dashboard queries use max() rather than sum() where that matters.
prometheus.scrape "postgres" {
  targets    = [{"__address__" = "postgres_exporter:9187", "host" = sys.env("ALLOY_HOSTNAME"), "color" = sys.env("ALLOY_COLOR")}]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// Per-container CPU/memory -- node_exporter above is host-wide only, this is
// what lets the dashboard tell api's usage apart from alloy's/postgres_exporter's.
prometheus.scrape "cadvisor" {
  targets    = [{"__address__" = "cadvisor:8080", "host" = sys.env("ALLOY_HOSTNAME"), "color" = sys.env("ALLOY_COLOR")}]
  forward_to = [prometheus.relabel.cadvisor.receiver]
}

// Keep only the cadvisor families the dashboards actually query; drop the rest of
// cadvisor's ~100 metric families so a rolling ASG replace duplicates far fewer
// active series into Mimir during the deploy window (this is what tipped the
// tenant active-series cap during a 2026-08-18 rolling deploy). Keep-list grepped
// from infra/grafana/dashboards/ocar-overview.json.
prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_usage_bytes|memory_working_set_bytes|spec_memory_limit_bytes|oom_events_total)"
    action        = "keep"
  }

  // Only the compose-managed services matter (matches ocar-overview.json's
  // own {name=~"ocar_.*"} queries) -- drops any stray/ad-hoc container on
  // the host, e.g. the CI migration's `docker run --name db_migrate`
  // (deploy.yml), permanently and with no allowlist to maintain.
  rule {
    source_labels = ["name"]
    regex         = "ocar_.*"
    action        = "keep"
  }

  // Allowlist beats denylist: kills id/image churn (a new value every
  // deploy -- id on every container recreate, image on every ocar_api
  // deploy since its tag changes) *and* any current/future
  // container_label_* noise (cadvisor's --store_container_labels
  // defaults to true) in one rule, instead of maintaining a drop-list.
  rule {
    regex  = "__name__|name|host|color"
    action = "labelkeep"
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// --- Traces pipeline ------------------------------------------------------
// The app sends traces to Alloy over OTLP/HTTP (http://alloy:4318) rather
// than to Grafana Cloud directly, so Grafana Cloud credentials live only
// here, not in the app's env — same reasoning as the logs pipeline above.
// Alloy forwards them to Tempo with basic auth attached.

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

otelcol.auth.basic "grafana_cloud" {
  // client_auth{} is docs.grafana.com/alloy/latest's documented replacement
  // for these top-level args, but it produced "no credential source
  // provided" against the actually-deployed v1.18.1 (verified live against
  // production Alloy logs, 2026-08-08) — the docs describe a newer version
  // than what's pinned in docker-compose.prod.yml. Revert to the
  // deprecated-but-functional form; revisit client_auth{} if/when the
  // pinned image is upgraded past v1.18.1.
  username = sys.env("GRAFANA_CLOUD_TEMPO_USER")
  password = sys.env("GRAFANA_CLOUD_API_KEY")
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("GRAFANA_CLOUD_TEMPO_URL")
    auth     = otelcol.auth.basic.grafana_cloud.handler
  }
}
