// infra/alloy/config.alloy
//
// Discovers all containers on this host, tails their combined stdout/stderr
// log stream, and attaches exactly four labels (container, service, env,
// host) to keep Loki's index small —
// see docs/superpowers/specs/2026-08-08-observability-stack-design.md
// MUST-DO #2. Everything else (requestId, userId, rideId, etc.) stays in
// the JSON log body untouched — Loki can still full-text/JSON-filter on it,
// it just isn't part of the indexed label set.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    target_label = "service"
    replacement   = "ocar"
  }

  rule {
    target_label = "env"
    replacement   = sys.env("ALLOY_ENV")
  }

  rule {
    target_label = "host"
    replacement   = sys.env("ALLOY_HOSTNAME")
  }

  // Which blue/green color this instance belongs to -- lets dashboards split
  // by color during a deploy (matches the EC2 Color tag in asg.tf).
  rule {
    target_label = "color"
    replacement   = sys.env("ALLOY_COLOR")
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  forward_to    = [loki.write.grafana_cloud.receiver, loki.process.s3_archive.receiver]
  relabel_rules = discovery.relabel.containers.rules
}

// S3 log archive (s3-logs-archive.tf): api container only, `body` marshaler
// = raw Pino lines, batched 5 min. Experimental component, needs
// --stability.level=experimental (docker-compose.prod.yml).
loki.process "s3_archive" {
  forward_to = [otelcol.receiver.loki.s3_archive.receiver]

  stage.match {
    selector = "{service=\"ocar\", container!=\"ocar_api\"}"
    action   = "drop"
  }
}

otelcol.receiver.loki "s3_archive" {
  output {
    logs = [otelcol.processor.batch.s3_archive.input]
  }
}

otelcol.processor.batch "s3_archive" {
  timeout         = "5m"
  send_batch_size     = 8192
  // Must be >= send_batch_size or Alloy refuses to load the whole config
  // ("send_batch_max_size must be greater or equal to send_batch_size when not 0"),
  // which leaves ocar_alloy unhealthy and blocks the deploy gate.
  send_batch_max_size = 8192

  output {
    logs = [otelcol.exporter.awss3.logs.input]
  }
}

otelcol.exporter.awss3 "logs" {
  s3_uploader {
    region                = sys.env("LOGS_ARCHIVE_REGION")
    s3_bucket             = sys.env("LOGS_ARCHIVE_BUCKET")
    s3_prefix             = "logs"
    s3_partition_format   = "year=%Y/month=%m/day=%d/hour=%H"
    s3_partition_timezone = "UTC"
    compression           = "gzip"
  }

  marshaler {
    type = "body"
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// --- Metrics pipeline ---------------------------------------------------
// Scrapes api, node_exporter, postgres, cadvisor -> Grafana Cloud (remote_write).
// sample_limit = circuit breaker: over it the whole scrape fails (up=0)
// instead of a cardinality blowup reaching Grafana. Generous on purpose;
// tune to ~3x max by (job, host) (scrape_samples_scraped).
//
// host label matches what the logs pipeline already tags each line with --
// without it, every instance's series arrive under the same identity and
// can't be told apart in a query or dashboard (see docs/superpowers/specs/
// 2026-08-08-observability-stack-design.md). color likewise matches the logs
// pipeline's color label -- lets dashboards split metrics by blue/green.
prometheus.scrape "api" {
  targets       = [{"__address__" = "api:4000", "host" = sys.env("ALLOY_HOSTNAME"), "color" = sys.env("ALLOY_COLOR")}]
  metrics_path  = "/metrics"
  sample_limit  = 20000
  forward_to    = [prometheus.relabel.api.receiver, metrics_s3.api.receiver]
}

// Latency histogram cost in Grafana = 14 series per route x method x status combination, kept for
// the life of the process; the API has ~230 routes, so it was the one series source that grows
// with use (and tipped the 15,000 cap in the worst-case maths). Grafana gets buckets only for
// 2xx responses and only the boundaries the dashboards and alerts need (0.1 .. 2.5 s and +Inf);
// _count and _sum stay for every status code, so 5xx ratios and request rates are unchanged.
// S3 gets the untouched scrape (metrics_s3.api above).
prometheus.relabel "api" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__", "status_code"]
    regex         = "http_request_duration_seconds_bucket;[^2].."
    action        = "drop"
  }

  rule {
    source_labels = ["__name__", "le"]
    regex         = "http_request_duration_seconds_bucket;(0\\.005|0\\.01|0\\.025|0\\.05|5|5\\.0|10|10\\.0)"
    action        = "drop"
  }
}

prometheus.scrape "node" {
  targets      = [{"__address__" = "node_exporter:9100", "host" = sys.env("ALLOY_HOSTNAME"), "color" = sys.env("ALLOY_COLOR")}]
  sample_limit = 20000
  forward_to   = [prometheus.relabel.node.receiver, metrics_s3.node.receiver]
}

// node_exporter ships ~500-700 series/host unfiltered -- tipped the 15k cap
// in the 2026-08-30 rollout. Keep-list covers incident/audit metrics too.
prometheus.relabel "node" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex = "node_(cpu_seconds_total|load1|load5|load15|memory_MemTotal_bytes|memory_MemAvailable_bytes|memory_SwapTotal_bytes|memory_SwapFree_bytes|memory_Dirty_bytes|memory_Writeback_bytes|filesystem_size_bytes|filesystem_avail_bytes|filesystem_files|filesystem_files_free|filesystem_readonly|disk_io_time_seconds_total|disk_read_bytes_total|disk_written_bytes_total|network_receive_bytes_total|network_transmit_bytes_total|network_receive_errs_total|network_transmit_errs_total|network_receive_drop_total|network_transmit_drop_total|filefd_allocated|filefd_maximum|boot_time_seconds)"
    action = "keep"
  }
}

// ALL scrapes (api, node, postgres, cadvisor, alloy) are also archived to S3,
// unfiltered, so nothing is lost when Grafana Cloud rejects writes (15,000
// active-series cap, HTTP 429 err-mimir-max-active-series, blanked every
// dashboard twice on 2026-10-17). One pipeline per exporter ("metrics_s3" below,
// declared once): OTLP JSON, gzip, 5 min batches, s3://<logs-archive-bucket>/
// metrics/<api|node|postgres|cadvisor|alloy>/year=/month=/day=/hour=/ (expiry in
// s3-logs-archive.tf). Postgres metrics go to S3
// ONLY: one host exposes ~3,400 pg series (per-table ~2,800), repeated by every
// host against the same database, which is what blew the cap.
prometheus.scrape "postgres" {
  targets      = [{"__address__" = "postgres_exporter:9187", "host" = sys.env("ALLOY_HOSTNAME"), "color" = sys.env("ALLOY_COLOR")}]
  sample_limit = 20000
  forward_to   = [metrics_s3.postgres.receiver]
}

declare "metrics_s3" {
  argument "prefix" { }

  otelcol.receiver.prometheus "in" {
    output {
      metrics = [otelcol.processor.batch.in.input]
    }
  }

  otelcol.processor.batch "in" {
    timeout             = "5m"
    send_batch_size     = 8192
    send_batch_max_size = 8192

    output {
      metrics = [otelcol.exporter.awss3.out.input]
    }
  }

  otelcol.exporter.awss3 "out" {
    s3_uploader {
      region                = sys.env("LOGS_ARCHIVE_REGION")
      s3_bucket             = sys.env("LOGS_ARCHIVE_BUCKET")
      s3_prefix             = argument.prefix.value
      s3_partition_format   = "year=%Y/month=%m/day=%d/hour=%H"
      s3_partition_timezone = "UTC"
      compression           = "gzip"
    }

    marshaler {
      type = "otlp_json"
    }
  }

  export "receiver" {
    value = otelcol.receiver.prometheus.in.receiver
  }
}

metrics_s3 "api"      { prefix = "metrics/api" }
metrics_s3 "node"     { prefix = "metrics/node" }
metrics_s3 "postgres" { prefix = "metrics/postgres" }
metrics_s3 "cadvisor" { prefix = "metrics/cadvisor" }
metrics_s3 "alloy"    { prefix = "metrics/alloy" }

// Per-container CPU/memory -- node_exporter above is host-wide only, this is
// what lets the dashboard tell api's usage apart from alloy's/postgres_exporter's.
prometheus.scrape "cadvisor" {
  targets      = [{"__address__" = "cadvisor:8080", "host" = sys.env("ALLOY_HOSTNAME"), "color" = sys.env("ALLOY_COLOR")}]
  sample_limit = 30000
  forward_to   = [prometheus.relabel.cadvisor.receiver, metrics_s3.cadvisor.receiver]
}

// Keep only the cadvisor families the dashboards query (tipped the series cap
// in the 2026-08-18 rolling deploy). Grepped from ocar-overview.json.
prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_usage_bytes|memory_working_set_bytes|spec_memory_limit_bytes|oom_events_total)"
    action        = "keep"
  }

  // Compose services only -- drops ad-hoc containers (e.g. db_migrate).
  rule {
    source_labels = ["name"]
    regex         = "ocar_.*"
    action        = "keep"
  }

  // Allowlist kills id/image churn and container_label_* noise in one rule.
  rule {
    regex  = "__name__|name|host|color"
    action = "labelkeep"
  }
}

// Alloy self-metrics for infra/terraform/observability/alerts-alloy.tf.
// Allowlist only: unfiltered this is ~220 series/host.
prometheus.scrape "alloy" {
  targets      = [{"__address__" = "127.0.0.1:12345", "host" = sys.env("ALLOY_HOSTNAME"), "color" = sys.env("ALLOY_COLOR")}]
  sample_limit = 5000
  forward_to   = [prometheus.relabel.alloy.receiver, metrics_s3.alloy.receiver]
}

prometheus.relabel "alloy" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "alloy_config_last_load_successful|alloy_component_controller_running_components|otelcol_exporter_(send_failed|sent)_log_records_total|prometheus_remote_storage_samples_failed_total|loki_write_dropped_bytes_total"
    action        = "keep"
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// --- Traces pipeline ------------------------------------------------------
// The app sends traces to Alloy over OTLP/HTTP (http://alloy:4318) rather
// than to Grafana Cloud directly, so Grafana Cloud credentials live only
// here, not in the app's env — same reasoning as the logs pipeline above.
// Alloy forwards them to Tempo with basic auth attached.

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

otelcol.auth.basic "grafana_cloud" {
  // client_auth{} failed on v1.18.1 ("no credential source provided",
  // verified live 2026-08-08); keep these deprecated args until upgrade.
  username = sys.env("GRAFANA_CLOUD_TEMPO_USER")
  password = sys.env("GRAFANA_CLOUD_API_KEY")
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("GRAFANA_CLOUD_TEMPO_URL")
    auth     = otelcol.auth.basic.grafana_cloud.handler
  }
}
