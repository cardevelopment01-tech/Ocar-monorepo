# ── API ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Ocar
VITE_DEMO_MODE=false

# ── Legal ────────────────────────────────────────────
# Base URL of the deployed rider app (apps/user), which hosts the canonical
# Terms & Privacy pages at /legal/terms and /legal/privacy. Blank falls back
# to https://ocar.in -- set this once the real production domain is known.
VITE_LEGAL_BASE_URL=

# ── Maps ─────────────────────────────────────────────
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAPS_ID=
# Optional: a dark Cloud-based Map Style ID (create in Google Cloud Console >
# Map Management) — this is now THE app-wide map style (DriverMapView defaults
# every screen to it, see its "map mode system" comment). Blank = falls back to
# VITE_GOOGLE_MAPS_ID's normal style everywhere, no code change needed either way.
VITE_GOOGLE_MAPS_DARK_MAP_ID=

# ── Push (Firebase Cloud Messaging) ─────────────────
# All blank = push registration is a safe no-op.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
