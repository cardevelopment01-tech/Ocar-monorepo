# 10.0.2.2 is the Android emulator's alias for the host machine's localhost.
# Use your machine's LAN IP instead when testing on a physical device.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Base URL of the deployed rider web app (apps/user), which hosts the
# canonical Terms & Privacy pages at /legal/terms and /legal/privacy. Blank
# falls back to https://ocar.in -- set this once the real production domain
# is known.
EXPO_PUBLIC_LEGAL_BASE_URL=
