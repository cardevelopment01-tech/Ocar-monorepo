{
  "expo": {
    "name": "Ocar Rider",
    "slug": "ocar-rider",
    "scheme": "ocarrider",
    "experiments": { "reactCompiler": true },
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/app-icon.png",
    "android": {
      "package": "com.ocar.rider",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/brand/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW", "android.permission.RECORD_AUDIO"],
      "allowBackup": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAAVGxzN9sRx8fOBOQxwITVIk8lPC6sGtM"
        }
      }
    },
    "notification": {
      "icon": "./assets/brand/notification-icon.png",
      "color": "#0A9FB0"
    },
    "ios": {
      "bundleIdentifier": "com.ocar.rider",
      "supportsTablet": false,
      "config": {
        "googleMapsApiKey": "AIzaSyAAVGxzN9sRx8fOBOQxwITVIk8lPC6sGtM"
      }
    },
    "plugins": [
      "expo-router",
    "../../packages/mobile-shared/plugins/withReleaseSigning.js",
[
  "expo-build-properties",
  {
    "android": {
      "enableMinifyInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true,
      "buildArchs": ["arm64-v8a", "armeabi-v7a"],
      "extraProguardRules": "-keep class io.invertase.firebase.** { *; }"
    }
  }
],
["expo-font", { "fonts": ["./node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf","./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf","./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf","./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf","./node_modules/@expo-google-fonts/space-grotesk/500Medium/SpaceGrotesk_500Medium.ttf","./node_modules/@expo-google-fonts/space-grotesk/600SemiBold/SpaceGrotesk_600SemiBold.ttf","./node_modules/@expo-google-fonts/space-grotesk/700Bold/SpaceGrotesk_700Bold.ttf"] }],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ocar needs your location to show nearby drivers and set your pickup point."
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0D1A",
          "image": "./assets/brand/logo-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "@react-native-firebase/app",
      ["expo-notifications", { "icon": "./assets/brand/notification-icon.png", "color": "#0E8FA3" }],
    "@react-native-firebase/messaging"
    ]
  }
}
