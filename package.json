{
  "name": "cab-booking-platform",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:api": "cd api && pnpm test",
    "lint": "turbo run lint",
    "migrate": "cd api && pnpm migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "infra:prd:init": "node infra/scripts/tf-guard.mjs prd init",
    "infra:prd:check": "node infra/scripts/tf-guard.mjs prd check",
    "infra:prd:plan": "node infra/scripts/tf-guard.mjs prd plan",
    "infra:prd:apply": "node infra/scripts/tf-guard.mjs prd apply",
    "infra:stg:init": "node infra/scripts/tf-guard.mjs stg init",
    "infra:stg:check": "node infra/scripts/tf-guard.mjs stg check",
    "infra:stg:plan": "node infra/scripts/tf-guard.mjs stg plan",
    "infra:stg:apply": "node infra/scripts/tf-guard.mjs stg apply",
    "infra:stg:destroy": "node infra/scripts/tf-guard.mjs stg destroy",
    "env:pull": "node infra/scripts/api-env.mjs pull",
    "env:edit": "node infra/scripts/api-env.mjs edit",
    "env:push": "node infra/scripts/api-env.mjs push",
    "env:diff": "node infra/scripts/api-env.mjs diff",
    "env:history": "node infra/scripts/api-env.mjs history",
    "infra:stg:status": "node infra/scripts/stg-power.mjs status",
    "infra:stg:pause": "node infra/scripts/stg-power.mjs pause",
    "infra:stg:resume": "node infra/scripts/stg-power.mjs resume --wait"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "shell-quote": "^1.11.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
