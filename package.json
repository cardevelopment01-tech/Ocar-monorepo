{
  "name": "cab-booking-platform",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:api": "cd api && pnpm test",
    "lint": "turbo run lint",
    "migrate": "cd api && pnpm migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "infra:staging:init": "cd infra/terraform && terraform init -reconfigure -backend-config=staging.backend.hcl",
    "infra:staging:plan": "cd infra/terraform && terraform plan -var-file=staging.tfvars -out=staging.tfplan",
    "infra:staging:apply": "cd infra/terraform && terraform apply staging.tfplan",
    "infra:staging:destroy": "cd infra/terraform && terraform destroy -var-file=staging.tfvars",
    "infra:prod:init": "cd infra/terraform && terraform init -reconfigure -backend-config=prod.backend.hcl",
    "infra:prod:plan": "cd infra/terraform && terraform plan -var=\"environment=prod\" -out=prod.tfplan",
    "infra:prod:apply": "node infra/scripts/tf-guard.mjs prod apply",
    "infra:prod:check": "node infra/scripts/tf-guard.mjs prod check",
    "infra:prd:init": "node infra/scripts/tf-guard.mjs prd init",
    "infra:prd:check": "node infra/scripts/tf-guard.mjs prd check",
    "infra:prd:plan": "node infra/scripts/tf-guard.mjs prd plan",
    "infra:prd:apply": "node infra/scripts/tf-guard.mjs prd apply"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "shell-quote": "^1.11.0"
    },
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract"]
  }
}
