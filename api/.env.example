# ── Database ────────────────────────────────────────
# On Neon, ALWAYS use the pooled ("-pooler") host, e.g.
#   postgresql://user:pass@ep-xxxx-pooler.<region>.aws.neon.tech/db?sslmode=require
# Neon's pooler is PgBouncer in transaction mode. This app is compatible: it uses
# unnamed prepared statements only (no PREPARE), sets no cross-query session state,
# and its one type parser is client-side. Keep the pool maxes modest (below) and
# let the pooler fan connections out. The direct (non-pooler) host caps hard on
# connections and cold-starts — do not point prod at it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocar
# 'password' (default, used here in local dev — Docker Postgres has no IAM auth):
# connect via DATABASE_URL above. 'iam': connect via a short-lived signed token
# (@aws-sdk/rds-signer) — see infra/terraform/rds.tf's
# iam_database_authentication_enabled comment for why this exists, and
# docs/INCIDENT_2026-08-25_PROD_DB_AUTH_OUTAGE.md for why it's not used for the
# RDS master user. 'secrets-manager' (recommended for prod, not yet the
# schema default): read the RDS master password directly from Secrets Manager
# (DB_SECRET_ARN) instead of copying it into a static env var, so there's
# never a stale copy after a rotation. In
# 'iam'/'secrets-manager' mode, DATABASE_URL above is unused; set DB_HOST/
# DB_PORT/DB_NAME/DB_USER (and DB_SECRET_ARN for 'secrets-manager') instead.
DB_AUTH_MODE=password
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_SECRET_ARN=
# Optional. Used only by the migration script (api/src/db/migrate.ts), never by
# the running app. Point this at Neon's DIRECT (non-pooler) host — migrations
# take a session-scoped advisory lock, which Neon's pooler (PgBouncer,
# transaction mode) doesn't support and can leave permanently stuck. Leave
# unset in local dev/CI, where DATABASE_URL is already a plain unpooled
# Postgres and there's no pooler to conflict with.
#   postgresql://user:pass@ep-xxxx.<region>.aws.neon.tech/db?sslmode=require
MIGRATION_DATABASE_URL=
DATABASE_POOL_MIN=2
# Request-handler pool. Kept small so the workers' separate pool (WORKER_POOL_MAX)
# can't starve user requests. Request 15 + worker 10 = 25 conns/instance.
DATABASE_POOL_MAX=15
# Separate pool for high-rate batch workers (gps-flush, notifications direct queries)
# so they draw from their own budget instead of the request pool.
WORKER_POOL_MAX=10

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_USER=30d
JWT_REFRESH_EXPIRY_ADMIN=24h

# ── TOTP (admin 2FA) — 32-byte key, hex-encoded (64 hex chars) ──
TOTP_ENCRYPTION_KEY=

# ── Bank account encryption (driver payouts) — 32-byte AES-256-GCM key,
# hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_ACCOUNT_ENCRYPTION_KEY=

# ── Razorpay ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX current account number to debit payouts from — see RazorpayX dashboard
RAZORPAYX_ACCOUNT_NUMBER=

# ── Exotel (call masking) ──────────────────────────
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_STATUS_CALLBACK_URL=
EXOTEL_WAIT_AUDIO_URL=
EXOTEL_WEBHOOK_SECRET=

# ── SMS providers ───────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
BULKSMSPLANS_API_ID=
BULKSMSPLANS_API_PASSWORD=
BULKSMSPLANS_SENDER_ID=
BULKSMSPLANS_OTP_TEMPLATE_ID=

# ── Push (FCM) ──────────────────────────────────────
FCM_SERVICE_ACCOUNT_KEY=
FCM_PROJECT_ID=

# ── Storage (S3 or MinIO) ───────────────────────────
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── App ─────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Maps ────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── BullMQ ──────────────────────────────────────────
BULLMQ_CONCURRENCY=5

# ── Test ────────────────────────────────────────────
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ocar_test
