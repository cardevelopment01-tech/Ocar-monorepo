    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "razorpay": "^2.9.0",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/uuid": "^9.0.7",
    "vitest": "^1.0.0",
    "supertest": "^6.3.0",
