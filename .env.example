# ── Database ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocar
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_USER=30d
JWT_REFRESH_EXPIRY_ADMIN=24h

# ── TOTP (admin 2FA) ────────────────────────────────
# 32-byte key, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# ── Razorpay ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── SMS providers ───────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
BULKSMSPLANS_API_ID=        # BulkSMSPlans API id — leave empty in dev
BULKSMSPLANS_API_PASSWORD=  # BulkSMSPlans API password — leave empty in dev
BULKSMSPLANS_SENDER_ID=
BULKSMSPLANS_OTP_TEMPLATE_ID=  # DLT-approved template id, login OTP only
ADMIN_PHONE=                # Admin phone for SOS + driver review alerts

# ── Storage (S3 or MinIO) ───────────────────────────
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
MINIO_ENDPOINT=http://localhost:9000

# ── Email (AWS SES) ─────────────────────────────────
SES_REGION=ap-south-1
SES_FROM_EMAIL=              # leave empty in dev — logs instead of sending

# ── App ─────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
ADMIN_APP_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── BullMQ ──────────────────────────────────────────
BULLMQ_CONCURRENCY=5

# ── Test ────────────────────────────────────────────
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ocar_test
