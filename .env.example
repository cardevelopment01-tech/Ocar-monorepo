# ── Database ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocar
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_USER=30d
JWT_REFRESH_EXPIRY_ADMIN=24h

# ── TOTP (admin 2FA) ────────────────────────────────
# 32-byte key, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# ── Razorpay ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=test
USER_APP_URL=http://localhost:3000
DRIVER_APP_URL=http://localhost:5173

# ── SMS providers ───────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
BULKSMSPLANS_API_ID=        # BulkSMSPlans API id — leave empty in dev
BULKSMSPLANS_API_PASSWORD=  # BulkSMSPlans API password — leave empty in dev
BULKSMSPLANS_SENDER_ID=
BULKSMSPLANS_OTP_TEMPLATE_ID=  # DLT-approved template id, login OTP only
BULKSMSPLANS_IVR_NUMBER=  # IVR call masking — account's assigned IVR number
ADMIN_PHONE=                # Admin phone for SOS + driver review alerts

# ── Storage (S3 or MinIO) ───────────────────────────
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
MINIO_ENDPOINT=http://localhost:9000

# ── Email (AWS SES) ─────────────────────────────────
SES_REGION=ap-south-1
# Which service sends email: ses (Amazon SES) or smtp (Google Workspace's SMTP relay, or any SMTP server). See docs/OPS_RUNBOOK.md.
EMAIL_PROVIDER=ses
# The sender, for either service: EMAIL_FROM=Ocar Admin <no-reply@your-domain>. With Google it must be an address in your Workspace domain.
# (SES_FROM_EMAIL still works as the sender when EMAIL_FROM is empty.)
EMAIL_FROM=
# Only for EMAIL_PROVIDER=smtp. User and password go together (leave both empty for an IP-allowlisted relay).
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# starttls (port 587), ssl (port 465), or none (local testing only; refused in production)
SMTP_SECURITY=starttls
#
# Amazon SES sender, e.g. SES_FROM_EMAIL=Ocar Admin <no-reply@your-domain>. Must be an SES-verified identity (set up DKIM/SPF/DMARC on the domain and
# move the account out of the SES sandbox, or only verified recipients get mail). Empty in dev = the email is printed instead of sent; empty in
# production = admin invite emails FAIL (loudly) rather than pretend to send.
SES_FROM_EMAIL=
# true only on a non-production server with no sender, so a tester can read the invite link in its log
ALLOW_DEV_EMAIL=false

# ── App ─────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
ADMIN_APP_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── BullMQ ──────────────────────────────────────────
BULLMQ_CONCURRENCY=5

# ── Test ────────────────────────────────────────────
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ocar_test
