# ── Database ────────────────────────────────────────
# 'postgres' = docker service name on ocar_net. If the DB is actually a
# managed host with its own pooler (e.g. Neon's "-pooler" endpoint) instead
# of this in-cluster postgres service, point DATABASE_URL at the POOLED host.
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/ocar
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Optional. Used only by the migration step (never by the running app).
# If DATABASE_URL above is a pooled connection (e.g. Neon's "-pooler" host),
# set this to the DIRECT (non-pooler) connection string instead. Migrations
# take a session-scoped advisory lock, which a transaction-mode pooler
# (PgBouncer, Neon's included) doesn't support and can leave stuck forever,
# hanging the container's startup migration on every future deploy. Leave
# blank if DATABASE_URL is already a direct connection (e.g. the in-cluster
# 'postgres' service above) — there's no pooler there to conflict with.
MIGRATION_DATABASE_URL=

# Used by docker-compose.prod.yml for the postgres container
POSTGRES_PASSWORD=<strong-random-password>

# ── Redis ───────────────────────────────────────────
# 'redis' = docker service name on ocar_net
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
REDIS_PASSWORD=<strong-random-password>

# ── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=<min-32-char-random-string>
JWT_REFRESH_SECRET=<min-32-char-random-string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_USER=30d
JWT_REFRESH_EXPIRY_ADMIN=24h

# ── Razorpay ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── SMS providers ───────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
BULKSMSPLANS_API_ID=
BULKSMSPLANS_API_PASSWORD=
BULKSMSPLANS_SENDER_ID=
BULKSMSPLANS_OTP_TEMPLATE_ID=
ADMIN_PHONE=

# ── Push (Firebase Cloud Messaging) ─────────────────
# Full service-account JSON, minified to a single line. Blank = push disabled (safe no-op).
FCM_SERVICE_ACCOUNT_KEY=
FCM_PROJECT_ID=

# ── Storage (S3) ────────────────────────────────────
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── App ─────────────────────────────────────────────
NODE_ENV=production
API_PORT=4000
API_BASE_URL=https://api.yourdomain.com

# Exact Vercel URLs — no trailing slashes
ALLOWED_ORIGINS=https://<user-app>.vercel.app,https://<driver-app>.vercel.app,https://<admin-app>.vercel.app

# ── BullMQ ──────────────────────────────────────────
BULLMQ_CONCURRENCY=5

# ── Docker Compose ──────────────────────────────────
GITHUB_REPOSITORY_OWNER=<your-github-username>
IMAGE_TAG=latest

# ── Observability (Grafana Cloud + Alloy) ───────────
# From Grafana Cloud stack → Loki connection page (see
# docs/superpowers/plans/2026-08-08-alloy-log-shipping.md Task 1).
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_API_KEY=
# Static labels attached to every shipped log line — keep these as the ONLY
# per-host/per-env labels (see spec MUST-DO #2). ALLOY_HOSTNAME must be unique
# per server once you add a second VPS.
ALLOY_ENV=production
ALLOY_HOSTNAME=ocar-vps-1
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_TEMPO_URL=
GRAFANA_CLOUD_TEMPO_USER=
