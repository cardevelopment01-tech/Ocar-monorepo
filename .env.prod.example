# ── Database ────────────────────────────────────────
# 'postgres' = docker service name on ocar_net
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/ocar
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Used by docker-compose.prod.yml for the postgres container
POSTGRES_PASSWORD=<strong-random-password>

# ── Redis ───────────────────────────────────────────
# 'redis' = docker service name on ocar_net
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
REDIS_PASSWORD=<strong-random-password>

# ── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=<min-32-char-random-string>
JWT_REFRESH_SECRET=<min-32-char-random-string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_USER=30d
JWT_REFRESH_EXPIRY_ADMIN=24h

# ── Razorpay ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── SMS providers ───────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
FAST2SMS_API_KEY=
ADMIN_PHONE=

# ── Push (Firebase Cloud Messaging) ─────────────────
# Full service-account JSON, minified to a single line. Blank = push disabled (safe no-op).
FCM_SERVICE_ACCOUNT_KEY=
FCM_PROJECT_ID=

# ── Storage (S3) ────────────────────────────────────
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── App ─────────────────────────────────────────────
NODE_ENV=production
API_PORT=4000
API_BASE_URL=https://api.yourdomain.com

# Exact Vercel URLs — no trailing slashes
ALLOWED_ORIGINS=https://<user-app>.vercel.app,https://<driver-app>.vercel.app,https://<admin-app>.vercel.app

# ── BullMQ ──────────────────────────────────────────
BULLMQ_CONCURRENCY=5

# ── Docker Compose ──────────────────────────────────
GITHUB_REPOSITORY_OWNER=<your-github-username>
IMAGE_TAG=latest
